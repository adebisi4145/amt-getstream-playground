# Copy to .env (git-ignored) and fill in. Never commit the secret.
STREAM_API_SECRET=

# Optional. Defaults shown.
# STREAM_API_KEY=s3c4w9uuvs5k
# STREAM_TOKEN_LIFETIME_SECONDS=3600
# PORT=5057

# Defaults depend on NODE_ENV (npm run dev:api-node sets development):
# development -> http://localhost:3000 and true; otherwise -> none and false.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# ALLOW_UNTRUSTED_REQUESTS=true
